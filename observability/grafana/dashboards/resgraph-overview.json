{
 "title": "resgraph-overview",
 "uid": "resgraph-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Ingest throughput (applied/s per worker)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (worker) (rate(ingest_applied_total[1m]))",
     "refId": "A",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Ingest lag (messages behind) \u2014 SLO threshold 31,500",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 31500
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(ingest_lag)",
     "refId": "A",
     "legendFormat": "max lag"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Batch apply p95 (s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(ingest_batch_apply_seconds_bucket[1m])))",
     "refId": "A",
     "legendFormat": "{{worker}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Stale skips + dead-letters (/s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ingest_skipped_total[1m]))",
     "refId": "A",
     "legendFormat": "stale skipped"
    },
    {
     "expr": "sum(rate(ingest_dlq_total[1m]))",
     "refId": "B",
     "legendFormat": "dead-lettered"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "API p95 by source (s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, source) (rate(api_request_seconds_bucket[1m])))",
     "refId": "A",
     "legendFormat": "{{source}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "SLO ratios (5m) \u2014 freshness >=0.99, composite >=0.95",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:ingest_freshness:ratio_5m",
     "refId": "A",
     "legendFormat": "freshness"
    },
    {
     "expr": "slo:composite_latency:ratio_5m",
     "refId": "B",
     "legendFormat": "composite"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Freshness budget remaining (run)",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "clamp_min((avg_over_time(slo:ingest_freshness:good[$__range]) - 0.99) / 0.01, 0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Composite budget remaining (run)",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 6,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "clamp_min((sum(increase(api_request_seconds_bucket{source=\"composite\",le=\"0.6\"}[$__range])) / sum(increase(api_request_seconds_count{source=\"composite\"}[$__range])) - 0.95) / 0.05, 0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Read rate vs invalid (/s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ingest_read_total[1m]))",
     "refId": "A",
     "legendFormat": "read"
    },
    {
     "expr": "sum(rate(ingest_invalid_total[1m]))",
     "refId": "B",
     "legendFormat": "invalid"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Phantoms created (rate + run total)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(graph_phantoms_created_total[1m]))",
     "refId": "A",
     "legendFormat": "created /s"
    },
    {
     "expr": "sum(graph_phantoms_created_total)",
     "refId": "B",
     "legendFormat": "total (run)"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Analyst SLO ratios (5m) \u2014 latency/cost >=0.95 (agent scraped, #145)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:analyst_latency:ratio_5m",
     "refId": "A",
     "legendFormat": "latency <=152s"
    },
    {
     "expr": "slo:analyst_cost:ratio_5m",
     "refId": "B",
     "legendFormat": "cost <=$0.30"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Analyst degraded ratio (5m) \u2014 objective <=0.05 (agent scraped, #145)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "slo:analyst_degraded:ratio_5m",
     "refId": "A",
     "legendFormat": "degraded"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}
